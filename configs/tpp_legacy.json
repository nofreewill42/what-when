{
  "arm": "tpp_legacy",
  "model": {
    "vocab": 128,
    "d_model": 256,
    "n_layers": 2,
    "layers": [
      "attn",
      "attn"
    ],
    "ffn": "relu",
    "ffn_hidden": 1024,
    "tie_embeddings": false,
    "attn": {
      "n_heads": 4,
      "rope_base": 10000.0,
      "qk_norm": false,
      "window": null
    },
    "swa": {
      "window": 256
    },
    "ww": {
      "n_heads": 128,
      "value_dim": 1,
      "R": 2,
      "chunk": 32,
      "what": "learned",
      "when": "learned",
      "decay": false,
      "tick_param": "softplus"
    },
    "fla": {
      "n_heads": 4,
      "head_dim": 64,
      "expand_v": 1.0,
      "use_gate": true,
      "conv_size": 4
    }
  },
  "train": {
    "optimizer": "adamw",
    "lr": 0.0003,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08,
    "weight_decay": 0.01,
    "grad_clip": 1.0,
    "schedule": "cosine",
    "warmup_frac": 0.02,
    "cooldown_frac": 0.2,
    "targets_per_update": 65536,
    "seq_len": 1024,
    "micro_batch": 16
  },
  "notes": "Old local recipe D256/L2: lr 3e-4, betas (0.9, 0.999), wd 0.01, cosine. Expected ~1.970 BPC at u8192 if the new harness matches the old one. A0 must copy the exact old FFN kind/width from the old project before running.",
  "lr_from": null,
  "param_match": false,
  "gpu_only": false
}
