{
  "arm": "gdn",
  "model": {
    "vocab": 128,
    "d_model": 256,
    "n_layers": 4,
    "layers": [
      "gdn",
      "gdn",
      "gdn",
      "gdn"
    ],
    "ffn": "swiglu",
    "ffn_hidden": 640,
    "tie_embeddings": false,
    "attn": {
      "n_heads": 4,
      "rope_base": 10000.0,
      "qk_norm": true,
      "window": null
    },
    "swa": {
      "window": 256
    },
    "ww": {
      "n_heads": 128,
      "value_dim": 1,
      "R": 2,
      "chunk": 64,
      "what": "learned",
      "when": "learned",
      "decay": false,
      "tick_param": "softplus"
    },
    "fla": {
      "n_heads": 4,
      "head_dim": 64,
      "expand_v": 1.0,
      "use_gate": true,
      "conv_size": 4
    }
  },
  "train": {
    "optimizer": "adamw",
    "lr": null,
    "betas": [
      0.9,
      0.95
    ],
    "eps": 1e-08,
    "weight_decay": 0.1,
    "grad_clip": 1.0,
    "schedule": "wsd",
    "warmup_frac": 0.02,
    "cooldown_frac": 0.2,
    "targets_per_update": 65536,
    "seq_len": 1024,
    "micro_batch": 16
  },
  "notes": "Gated DeltaNet (fla) in the same backbone: the mature delta-rule reference. FFN hidden 640 (not 704) to stay within +-3% params (A0.4).",
  "lr_from": null,
  "param_match": true,
  "gpu_only": true
}
